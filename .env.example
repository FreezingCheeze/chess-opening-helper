# Supabase Project Settings -> API.
# Add both values to enable account-based sync across devices.
# Turn off email confirmation to allow immediate sign-in.
# For a new project, run 0001, 0002, and 0003; if 0001 and 0002 were already applied, run only 0003.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
